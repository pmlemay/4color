{
  "id": "spiral-galaxy-murdoku-3",
  "title": "Spiral Galaxy Murdoku",
  "authors": [
    "PmLemay"
  ],
  "specialRules": [
    "1. Everyone is at the center of their room except the victim",
    "2. All occupied rooms have 180degrees rotational symmetry (around their center occupant).",
    "3. All unoccupied rooms have exactly one black hole. All black holes are in unoccupied rooms. All black holes are shown.",
    "4. White circles are the only possible locations for suspects."
  ],
  "rules": [
    "Place everyone on the grid according to their clue to find the murderer. He was in a region alone with the victim.",
    "Only 1 person per row and per column.",
    "\"Beside\" means in the same room and orthogonally adjacent."
  ],
  "clues": [
    "A (Woman - Alice). Her room contained a bed.",
    "B (Woman - Blanche) Her room of area 1 was adjacent to the only other room sharing that same area size.",
    "C (Woman - Celeste). She was two rows north of Blanche.",
    "D (Man - Drake). He was on a carpet.",
    "E (Man - Edgar). His room was the same width as Drake's room.",
    "F (Man - Frank). His room shares two edges with Celeste's room.",
    "V (Man - Vasco). The victim. He was alone with the murderer."
  ],
  "difficulty": "Medium",
